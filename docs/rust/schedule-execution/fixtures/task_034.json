  "contracts": {
    "pair": "check all members before insert; replacing/removing one removes related region; expose atomic batch snapshot",
    "identity": "stale operator cannot delete replacement",
    "expiration": "all members checked in final expiry pass",
    "waiting": "count batches by first description; bypass waiting limit on promote; retry rejected batches",
    "scope": "admission and removal only; dispatch and store limits deferred"
  },
  "scenarios": [
    {
      "name": "identity-remove",
      "inputs": {
        "old_priority": 1,
        "new_priority": 2,
        "remove": "old Arc"
      },
      "expected": {
        "old_status": "REPLACED",
        "remaining": "new Arc",
        "count_region": 1
      }
    },
