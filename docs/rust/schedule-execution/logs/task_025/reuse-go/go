#!/usr/bin/env python3
"""Reuse the pre-task etcd I/O fixture; reject every actual Go command."""
import hashlib,json,os,shutil,sys
from pathlib import Path
argv=sys.argv[1:]
if len(argv)!=4 or argv[0:2]!=['build','-o'] or argv[3]!='./scripts/rust-etcd-fixture':
 raise SystemExit('task025: actual Go commands disabled during Rust validation: '+repr(argv))
target=Path(os.environ['CARGO_TARGET_DIR']).resolve()
source=Path(os.environ['PD_EXISTING_ETCD_FIXTURE']).resolve();destination=Path(argv[2]).resolve()
assert source.parent==target and destination.parent==target
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
assert sha(source)==os.environ['PD_EXISTING_ETCD_FIXTURE_SHA256']
shutil.copyfile(source,destination);destination.chmod(0o755)
with Path(os.environ['PD_GO_REUSE_LOG']).open('a') as f:
 f.write(json.dumps(dict(requested_argv=argv,action='copy_existing_etcd_fixture',source=str(source),destination=str(destination),sha256=sha(destination)))+'\n')
