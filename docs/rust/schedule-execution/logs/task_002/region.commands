config max-variable-recurse 3
config max-array-values 8
print "CASE initial"
call regionsOld.GetTotalRegionCount()
call regionsOld.GetRegion(9999)
print items[0].meta
print "CASE insert"
call -unsafe regionsOld.CheckAndPutRegion(items[0])
