"""Reuse the pre-task etcd I/O fixture; reject every actual Go command."""
import hashlib,json,os,shutil,sys
from pathlib import Path
argv=sys.argv[1:]
if argv==['mod','download','-json','github.com/pingcap/kvproto@v0.0.0-20261016101560-f8ad079c8e98']:
 archive=Path('/Users/xiangmin/go/pkg/mod/cache/download/github.com/pingcap/kvproto/@v/v0.0.0-20261016101560-f8ad079c8e98.zip')
 assert hashlib.sha256(archive.read_bytes()).hexdigest()=='aff09d074d493874bfd7e3e63c766a8d93f42901ff235dde2d2ced0c7f2a615e'
 print(json.dumps({'Zip':str(archive)}))
 with Path(os.environ['PD_GO_REUSE_LOG']).open('a') as f:
  f.write(json.dumps(dict(requested_argv=argv,action='readonly_cached_kvproto_zip',sha256=hashlib.sha256(archive.read_bytes()).hexdigest()))+'\n')
 raise SystemExit(0)
if len(argv)!=4 or argv[0:2]!=['build','-o'] or argv[3]!='./scripts/rust-etcd-fixture':
 raise SystemExit('task067-regression: actual Go commands disabled during Rust validation: '+repr(argv))
target=Path(os.environ['CARGO_TARGET_DIR']).resolve()
source=Path(os.environ['PD_EXISTING_ETCD_FIXTURE']).resolve();destination=Path(argv[2]).resolve()
assert source.parent==target and destination.parent==target
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
assert sha(source)==os.environ['PD_EXISTING_ETCD_FIXTURE_SHA256']
# Match go build's replace semantics when an old PID-named output exists.
# Link to a unique temporary path, then atomically replace; never write source bytes.
assert destination != source
previous_sha256=sha(destination) if destination.exists() else None
temporary=destination.with_name(destination.name+'.reuse-'+str(os.getpid()))
try:
 os.link(source,temporary)
 os.replace(temporary,destination)
finally:
 if temporary.exists(): temporary.unlink()

with Path(os.environ['PD_GO_REUSE_LOG']).open('a') as f:
 f.write(json.dumps(dict(requested_argv=argv,action='atomic_hardlink_existing_etcd_fixture',previous_sha256=previous_sha256,source=str(source),destination=str(destination),sha256=sha(destination)))+'\n')
