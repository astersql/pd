break *0x1592a30
condition 1 collector != nil
continue
clearall
config max-variable-recurse 0
config max-array-values 10
print "INPUT stores"
print stores
call stores[0].GetID()
call stores[1].GetID()
call stores[2].GetID()
call stores[3].GetID()
call -unsafe filters[1] = filters[0]
call -unsafe filters[0] = filter.NewExcludedFilter("task005", filter.NewSnapshotSendFilter(stores[:1], 1).(*filter.SnapshotSenderFilter).senders, filter.NewSnapshotSendFilter(stores[1:2], 1).(*filter.SnapshotSenderFilter).senders)
print "CASE source_empty"
call -unsafe collector = plan.NewCollector(collector.basePlan)
set collector.basePlan.(*plan.BalanceSchedulerPlan).Step = 0
call -unsafe filter.SelectSourceStores(stores, filters[:0], conf, collector, nil)
print collector.unschedulablePlans
print "CASE target_empty"
call -unsafe collector = plan.NewCollector(collector.basePlan)
set collector.basePlan.(*plan.BalanceSchedulerPlan).Step = 0
call -unsafe filter.SelectTargetStores(stores, filters[:0], conf, collector, nil)
print collector.unschedulablePlans
print "CASE unavailable_empty"
call -unsafe collector = plan.NewCollector(collector.basePlan)
set collector.basePlan.(*plan.BalanceSchedulerPlan).Step = 0
call -unsafe filter.SelectUnavailableTargetStores(stores, filters[:0], conf, collector, nil)
print collector.unschedulablePlans
print "CASE excluded_source"
call -unsafe collector = plan.NewCollector(collector.basePlan)
set collector.basePlan.(*plan.BalanceSchedulerPlan).Step = 0
call -unsafe filter.SelectSourceStores(stores, filters[:1], conf, collector, nil)
print collector.unschedulablePlans
call collector.unschedulablePlans[0].GetStep()
call collector.unschedulablePlans[0].GetStatus()
call collector.unschedulablePlans[0].GetResource(0)
print "CASE excluded_target"
call -unsafe collector = plan.NewCollector(collector.basePlan)
set collector.basePlan.(*plan.BalanceSchedulerPlan).Step = 0
call -unsafe filter.SelectTargetStores(stores, filters[:1], conf, collector, nil)
print collector.unschedulablePlans
call collector.unschedulablePlans[0].GetStep()
call collector.unschedulablePlans[0].GetStatus()
call collector.unschedulablePlans[0].GetResource(0)
print "CASE excluded_unavailable"
call -unsafe collector = plan.NewCollector(collector.basePlan)
set collector.basePlan.(*plan.BalanceSchedulerPlan).Step = 0
call -unsafe filter.SelectUnavailableTargetStores(stores, filters[:1], conf, collector, nil)
print collector.unschedulablePlans
call collector.unschedulablePlans[0].GetStep()
call collector.unschedulablePlans[0].GetStatus()
call collector.unschedulablePlans[0].GetResource(2)
print "CASE target_step2"
call -unsafe collector = plan.NewCollector(collector.basePlan)
set collector.basePlan.(*plan.BalanceSchedulerPlan).Step = 2
call -unsafe filter.SelectTargetStores(stores, filters[:1], conf, collector, nil)
print collector.unschedulablePlans
call collector.unschedulablePlans[0].GetStep()
call collector.unschedulablePlans[0].GetStatus()
call collector.unschedulablePlans[0].GetResource(2)
print "CASE first_excluded"
call -unsafe collector = plan.NewCollector(collector.basePlan)
set collector.basePlan.(*plan.BalanceSchedulerPlan).Step = 2
set stores[1].meta.NodeState = 3
call filters[1].Target(conf, stores[1])
call -unsafe filter.SelectTargetStores(stores[1:2], filters[:2], conf, collector, nil)
print collector.unschedulablePlans
call collector.unschedulablePlans[0].GetStep()
call collector.unschedulablePlans[0].GetStatus()
call collector.unschedulablePlans[0].GetResource(2)
print "CASE first_state"
call -unsafe collector = plan.NewCollector(collector.basePlan)
set collector.basePlan.(*plan.BalanceSchedulerPlan).Step = 2
set stores[1].meta.NodeState = 3
call -unsafe filters[0] = filters[1]
call -unsafe filter.SelectTargetStores(stores[1:2], filters[:2], conf, collector, nil)
print collector.unschedulablePlans
call collector.unschedulablePlans[0].GetStep()
call collector.unschedulablePlans[0].GetStatus()
call collector.unschedulablePlans[0].GetResource(2)
exit
